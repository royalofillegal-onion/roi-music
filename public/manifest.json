
{
  "name": "ROI MUSIC - Ultimate Music Experience",
  "short_name": "ROI MUSIC",
  "description": "Premium Music Streaming Platform with High-Quality Audio and Seamless Experience",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#9333ea",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment", "multimedia", "audio"],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "protocol_handlers": [
    {
      "protocol": "web+music",
      "url": "/share/%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "audio/*": [".mp3", ".wav", ".ogg", ".m4a", ".flac"]
      }
    }
  ],
  "screenshots": [
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ROI MUSIC Dashboard"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Music",
      "short_name": "Search",
      "description": "Discover new music and artists",
      "url": "/search",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Playlists",
      "short_name": "Playlists",
      "description": "Access your personal playlists",
      "url": "/playlists",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Liked Songs",
      "short_name": "Favorites",
      "description": "Your favorite tracks",
      "url": "/liked",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Live Radio",
      "short_name": "Live",
      "description": "Live music streaming",
      "url": "/live",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "capture_links": "existing-client-navigate",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred"
}
