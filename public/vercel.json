      "destination": "/index.html"
    },
    {
      "source": "/song/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/shared/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/music/:path*",
      "destination": "/index.html"
